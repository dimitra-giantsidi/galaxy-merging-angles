#!/bin/bash

box="r"
num="741"
numpix="8000"

echo "Applying the 2D exponential fit"
twod_fit="substructure_detection/twod_exp_fit.ipynb"

papermill "$twod_fit" "$twod_fit"

if [ $? -eq 0 ]; then
    echo "Success on opening 2D fitter!"
else
    echo "Failure on opening 2D fitter."
    exit 1
fi

echo "Applying Segment"
sd_path="/home/giantsid/MAP/substructure_detection/sd_outputs"
twod_exp_fits_path="$sd_path""/twod_exp_fit"
seg_path="$sd_path""/Segment"
for file in "$twod_exp_fits_path"/"$box"_"$num"/fits_files/*; do
    if [ -f "$file" ]; then
        echo $(basename "$file")
        readarray -t numbers < <(echo $(basename "$file") | grep -E -o '[0-9]+(\.[0-9]+)?')

        angles=("${numbers[@]:1:${#numbers[@]}-2}")
        dec=${angles[0]}
        azi=${angles[1]}
        
        astarithmetic "$twod_exp_fits_path"/"$box"_"$num"/fits_files/$(basename "$file") --hdu=0 2 gt --output="$seg_path"/"$box"_"$num"/masks/mask_"$box"_"$num"_d="$dec"_a="$azi"_pix="$numpix".fits

        astsegment "$twod_exp_fits_path"/"$box"_"$num"/fits_files/$(basename "$file") --hdu=0 --detection="$seg_path"/"$box"_"$num"/masks/mask_"$box"_"$num"_d="$dec"_a="$azi"_pix="$numpix".fits --dhdu=1 --std=1 --clumpsnthresh=3.0 --output="$seg_path"/"$box"_"$num"/segmented/segmented_"$box"_"$num"_d="$dec"_a="$azi"_pix="$numpix".fits
    fi
done

echo "Segment finished (this doesn't guarantee it worked)."

echo "Opening visualizer"
visuals="/home/giantsid/MAP/code/visualizer.ipynb"

papermill "$visuals" "$visuals"

if [ $? -eq 0 ]; then
    echo "Success on opening visualizer!"
else
    echo "Failure on opening visualizer."
    exit 1
fi

jupyter notebook "$visuals"

echo "All done!"
