    "# calculate the average A, h, q, x_offset, y_offset, theta, C to inform the prediction above\n",
    "avg_A = 0\n",
    "avg_h = 0\n",
    "avg_q = 0\n",
    "avg_x_offset = 0\n",
    "avg_y_offset = 0\n",
    "avg_theta = 0.0\n",
    "avg_C = 0\n",
    "\n",
    "for i in range(24):\n",
    "    avg_A = avg_A + As[i]\n",
    "    avg_h = avg_h + hs[i]\n",
    "    avg_q = avg_q + qs[i]\n",
    "    avg_x_offset = avg_x_offset + x_offsets[i]\n",
    "    avg_y_offset = avg_y_offset + y_offsets[i]\n",
    "    #avg_theta = avg_theta + thetas[i]\n",
    "    avg_C = avg_C = Cs[i]\n",
    "\n",
    "avg_A = round(avg_A / 24, 1)\n",
    "avg_h = round(avg_h / 24, 1)\n",
    "avg_q = round(avg_q / 24, 1)\n",
    "avg_x_offset = round(avg_x_offset / 24, 1)\n",
    "avg_y_offset = round(avg_y_offset / 24, 1)\n",
    "# avg_theta = round(avg_theta / 24, 1)\n",
    "avg_C = round(avg_C / 24, 1)\n",
    "\n",
    "print(f'{avg_A} , {avg_h}, {avg_q}, {avg_x_offset}, {avg_y_offset}, {avg_theta}, {avg_C}')"
